// Builds the DRI reference data: scripts/nutrition/dri/dri.json and the migration that loads it.
// Run: node --experimental-strip-types scripts/nutrition/dri/build_dris.mts
//
// Source of every number: the National Academies of Sciences, Engineering, and Medicine (formerly the Institute
// of Medicine) Dietary Reference Intakes, RDA and AI columns, as reproduced by Health Canada
// (canada.ca > Dietary Reference Intakes tables: elements, vitamins, macronutrients), read 2026-10-17 and checked
// line by line. Exceptions, from the 2019 NASEM report "Dietary Reference Intakes for Sodium and Potassium":
// the potassium AI (Health Canada's table already carries these values) and the sodium CDRR (Chronic Disease Risk
// Reduction intake, a ceiling, not a target; Health Canada's older table shows the sodium AI instead).
// Age bands are the DRI bands; age 13 uses the 9-13 band.
//
// Pregnancy, breastfeeding and smoking change several values (iron, folate, vitamin C...). The app does not
// ask about them, so this table holds the non-pregnant, non-lactating values only.
import { writeFileSync } from "node:fs";

type Sex = "female" | "male";
// bands in order: 9-13, 14-18, 19-30, 31-50, 51-70, 71+
const BANDS: [number, number][] = [
  [9, 13],
  [14, 18],
  [19, 30],
  [31, 50],
  [51, 70],
  [71, 120],
];
type Row = { key: string; kind: "rda" | "ai" | "cdrr"; male: number[]; female: number[] };
const ROWS: Row[] = [
  { key: "calcium_mg", kind: "rda", male: [1300, 1300, 1000, 1000, 1000, 1200], female: [1300, 1300, 1000, 1000, 1200, 1200] },
  { key: "iron_mg", kind: "rda", male: [8, 11, 8, 8, 8, 8], female: [8, 15, 18, 18, 8, 8] },
  { key: "magnesium_mg", kind: "rda", male: [240, 410, 400, 420, 420, 420], female: [240, 360, 310, 320, 320, 320] },
  { key: "zinc_mg", kind: "rda", male: [8, 11, 11, 11, 11, 11], female: [8, 9, 8, 8, 8, 8] },
  { key: "phosphorus_mg", kind: "rda", male: [1250, 1250, 700, 700, 700, 700], female: [1250, 1250, 700, 700, 700, 700] },
  { key: "selenium_mcg", kind: "rda", male: [40, 55, 55, 55, 55, 55], female: [40, 55, 55, 55, 55, 55] },
  { key: "copper_mg", kind: "rda", male: [0.7, 0.89, 0.9, 0.9, 0.9, 0.9], female: [0.7, 0.89, 0.9, 0.9, 0.9, 0.9] },
  { key: "manganese_mg", kind: "ai", male: [1.9, 2.2, 2.3, 2.3, 2.3, 2.3], female: [1.6, 1.6, 1.8, 1.8, 1.8, 1.8] },
  { key: "potassium_mg", kind: "ai", male: [2500, 3000, 3400, 3400, 3400, 3400], female: [2300, 2300, 2600, 2600, 2600, 2600] },
  { key: "sodium_mg", kind: "cdrr", male: [1800, 2300, 2300, 2300, 2300, 2300], female: [1800, 2300, 2300, 2300, 2300, 2300] },
  { key: "vitamin_a_mcg_rae", kind: "rda", male: [600, 900, 900, 900, 900, 900], female: [600, 700, 700, 700, 700, 700] },
  { key: "vitamin_c_mg", kind: "rda", male: [45, 75, 90, 90, 90, 90], female: [45, 65, 75, 75, 75, 75] },
  { key: "vitamin_d_mcg", kind: "rda", male: [15, 15, 15, 15, 15, 20], female: [15, 15, 15, 15, 15, 20] },
  { key: "vitamin_e_mg", kind: "rda", male: [11, 15, 15, 15, 15, 15], female: [11, 15, 15, 15, 15, 15] },
  { key: "vitamin_k_mcg", kind: "ai", male: [60, 75, 120, 120, 120, 120], female: [60, 75, 90, 90, 90, 90] },
  { key: "thiamin_mg", kind: "rda", male: [0.9, 1.2, 1.2, 1.2, 1.2, 1.2], female: [0.9, 1.0, 1.1, 1.1, 1.1, 1.1] },
  { key: "riboflavin_mg", kind: "rda", male: [0.9, 1.3, 1.3, 1.3, 1.3, 1.3], female: [0.9, 1.0, 1.1, 1.1, 1.1, 1.1] },
  { key: "niacin_mg", kind: "rda", male: [12, 16, 16, 16, 16, 16], female: [12, 14, 14, 14, 14, 14] },
  { key: "vitamin_b6_mg", kind: "rda", male: [1.0, 1.3, 1.3, 1.3, 1.7, 1.7], female: [1.0, 1.2, 1.3, 1.3, 1.5, 1.5] },
  { key: "folate_mcg_dfe", kind: "rda", male: [300, 400, 400, 400, 400, 400], female: [300, 400, 400, 400, 400, 400] },
  { key: "vitamin_b12_mcg", kind: "rda", male: [1.8, 2.4, 2.4, 2.4, 2.4, 2.4], female: [1.8, 2.4, 2.4, 2.4, 2.4, 2.4] },
  { key: "pantothenic_mg", kind: "ai", male: [4, 5, 5, 5, 5, 5], female: [4, 5, 5, 5, 5, 5] },
  { key: "choline_mg", kind: "ai", male: [375, 550, 550, 550, 550, 550], female: [375, 400, 425, 425, 425, 425] },
  { key: "fiber_g", kind: "ai", male: [31, 38, 38, 38, 30, 30], female: [26, 26, 25, 25, 21, 21] },
];

const out: { nutrient_key: string; sex: Sex; age_min: number; age_max: number; amount: number; kind: string }[] = [];
for (const r of ROWS)
  for (const sex of ["male", "female"] as const)
    BANDS.forEach(([a, b], i) => out.push({ nutrient_key: r.key, sex, age_min: a, age_max: b, amount: r[sex][i], kind: r.kind }));

writeFileSync(new URL("./dri.json", import.meta.url), JSON.stringify(out, null, 1) + "\n");

const values = out.map((o) => `  ('${o.nutrient_key}', '${o.sex}', ${o.age_min}, ${o.age_max}, ${o.amount}, '${o.kind}')`).join(",\n");
const sql = `-- Wave 10c (Me lane): Dietary Reference Intakes by sex and age, and a source tag on the Me food diary.
-- GENERATED by scripts/nutrition/dri/build_dris.mts. Edit the script and regenerate; do not edit by hand.
--
-- nutrient_dris: the National Academies (NASEM) RDA / AI by sex and age band for every vitamin and mineral we
-- track, plus fibre (AI) and the sodium CDRR (a ceiling). Used by Me ("All nutrients today") so a 70-year-old
-- woman and a 25-year-old man are not measured against the same FDA label number. Recipe pages keep the FDA
-- label Daily Values in nutrients.dv_amount. Sources are in scripts/nutrition/dri/build_dris.mts.
-- Pregnancy, breastfeeding and smoking are not modelled (the app does not collect them).
--
-- me_food_log.source: 'recipe' | 'food' | 'quick', so the diary can say what an entry really is. Before this,
-- "Quick add" was inferred from an empty nutrient snapshot and mislabelled ingredient and brand logs.
--
-- Reference table: select-only for clients (rows arrive by migration), RLS on. Non-superuser safe.

begin;

create table public.nutrient_dris (
  nutrient_key text     not null references public.nutrients (key) on update cascade on delete cascade,
  sex          text     not null check (sex in ('female', 'male')),
  age_min      smallint not null check (age_min between 0 and 120),
  age_max      smallint not null check (age_max between 0 and 120),
  amount       numeric  not null check (amount > 0),
  kind         text     not null check (kind in ('rda', 'ai', 'cdrr')),
  primary key (nutrient_key, sex, age_min),
  check (age_max >= age_min)
);
comment on table public.nutrient_dris is
  'NASEM Dietary Reference Intakes (RDA/AI; sodium CDRR is a ceiling) by sex and age band, in the units of nutrients.unit. Non-pregnant, non-lactating.';
comment on column public.nutrient_dris.kind is 'rda = Recommended Dietary Allowance, ai = Adequate Intake, cdrr = Chronic Disease Risk Reduction intake (an upper bound).';

insert into public.nutrient_dris (nutrient_key, sex, age_min, age_max, amount, kind) values
${values};

alter table public.nutrient_dris enable row level security;
revoke all on public.nutrient_dris from anon, authenticated;
grant select on public.nutrient_dris to anon, authenticated;
create policy "reference data is public" on public.nutrient_dris for select using (true);

alter table public.me_food_log add column source text;
update public.me_food_log
   set source = case
     when recipe_id is not null or servings is not null then 'recipe'
     when nutrients is not null then 'food'
     else 'quick'
   end;
alter table public.me_food_log
  alter column source set not null,
  alter column source set default 'quick',
  add constraint me_food_log_source_check check (source in ('recipe', 'food', 'quick'));
comment on column public.me_food_log.source is 'recipe = logged from a Minced recipe, food = an ingredient or brand with an amount, quick = typed by hand.';

commit;
`;
writeFileSync(new URL("../../../supabase/migrations/20261018140000_nutrient_dris_and_food_source.sql", import.meta.url), sql);
console.log(`${out.length} DRI rows`);
